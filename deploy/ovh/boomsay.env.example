# Root-owned real file: /etc/boomsay/boomsay.env, mode0600.
# Use a dedicated app subdomain; do not replace boomsay.com or its email DNS.
APP_HOST=demo.YOUR-DOMAIN.example
TLS_EMAIL=YOUR-EMAIL@example.invalid
RELEASE_TAG=local
# Generate independent random hexadecimal strings (at least32 characters).
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
REDIS_PASSWORD=REPLACE_WITH_RANDOM_HEX
JWT_SECRET=REPLACE_WITH_RANDOM_HEX
INTERNAL_API_SECRET=REPLACE_WITH_RANDOM_HEX
SURVEY_DEMO_PASSWORD=REPLACE_WITH_RANDOM_HEX
# Generate a Fernet key (32 random bytes, urlsafe-base64 encoded).
LLM_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
# Counts and original-answer browsing can be tested without a live model.
# Configure a chosen provider privately to test real narrative AI answers.
ASK_GENIUS_ENABLED=false
ASK_GENIUS_PROVIDER=
ASK_GENIUS_MODEL=
ASK_GENIUS_BASE_URL=
ASK_GENIUS_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
