{
  "catalog_version": 1,
  "rating_labels": {
    "1": "Terrible",
    "2": "Bad",
    "3": "Okay",
    "4": "Good",
    "5": "Excellent"
  },
  "templates": [
    {
      "id": "move_in_v1",
      "event_type": "move_in_completed",
      "title": "Tell us about your move-in",
      "questions": [
        {
          "id": "move_in_overall",
          "type": "rating",
          "required": true,
          "text": "Overall, how would you rate your move-in experience at {community_name}?"
        },
        {
          "id": "apartment_condition",
          "type": "rating",
          "required": true,
          "text": "How would you rate the condition of your apartment when you received your keys?"
        },
        {
          "id": "move_in_unresolved",
          "type": "single_choice",
          "required": true,
          "text": "Is anything from your move-in still unresolved?",
          "options": [
            {
              "value": "yes",
              "label": "Yes"
            },
            {
              "value": "no",
              "label": "No"
            },
            {
              "value": "not_sure",
              "label": "Not sure"
            }
          ]
        },
        {
          "id": "move_in_comment",
          "type": "text",
          "required": false,
          "max_length": 2000,
          "text": "What would you like us to know about your move-in experience?"
        }
      ]
    },
    {
      "id": "maintenance_v1",
      "event_type": "maintenance_completed",
